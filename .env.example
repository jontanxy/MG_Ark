# ---- Telegram --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:replace-with-token-from-BotFather
# Your own numeric Telegram user id (ask @userinfobot). This account is the Super Admin.
SUPER_ADMIN_TELEGRAM_ID=123456789

# ---- Access ----------------------------------------------------------------
# Used ONLY on the very first start to seed the access password. Change later with /setpassword.
INITIAL_ACCESS_PASSWORD=change-me-please
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
PROVISIONING_TOKEN_TTL_HOURS=24
# Leave unauthorised groups automatically after N minutes (0 = never leave)
UNAUTHORISED_GROUP_LEAVE_MINUTES=60
# Abuse guards: unknown senders get one reply per interval; too many wrong passwords across all
# accounts pause registration and alert the Super Admin; group /status re-uses a recent check.
UNREGISTERED_REPLY_INTERVAL_SECONDS=60
PASSWORD_BREAKER_FAILURES=30
PASSWORD_BREAKER_WINDOW_MINUTES=10
PASSWORD_BREAKER_PAUSE_MINUTES=15
STATUS_COOLDOWN_SECONDS=60

# ---- Storage ---------------------------------------------------------------
DATABASE_URL=sqlite:///data/mg_archive.sqlite3
WORK_DIR=data/work

# ---- Google Drive ----------------------------------------------------------
# service_account (recommended, use with a Shared Drive) | oauth (personal Google account) | fake (no Google, for trying the bot)
GOOGLE_AUTH_MODE=service_account
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service-account.json
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=secrets/oauth-client.json
GOOGLE_OAUTH_TOKEN_FILE=secrets/oauth-token.json
# The folder that will contain every project folder (copy the id from its Drive URL).
# Share this folder (or its Shared Drive) with the bot's Google identity as Content manager.
DRIVE_ROOT_FOLDER_ID=

# ---- Folder names (defaults match the requirements; override only if needed) ----
# FOLDER_NAME_HAP=Hap/Hap Alpha
# FOLDER_NAME_PREVIEWS=_Previews

# ---- Previews (MP4s are stored in <Project>/_Previews/ on Drive; the bot shares their links) ----
FFMPEG_PATH=ffmpeg
PREVIEWS_ENABLED=true
PREVIEW_MAX_WIDTH=1280
PREVIEW_CRF=26

# ---- Scheduling ------------------------------------------------------------
SCAN_INTERVAL_MINUTES=30
REMINDER_HOUR=10
REMINDER_MIN_GAP_HOURS=20
# IANA timezone for reminders and timestamps (empty = host timezone)
TIMEZONE=Asia/Singapore

SEARCH_PAGE_SIZE=5
LOG_LEVEL=INFO
# Rotating log file (5 MB x 3). Leave empty to log to the terminal only.
LOG_FILE=data/bot.log
